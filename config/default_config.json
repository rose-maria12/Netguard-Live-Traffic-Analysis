  "scoring": {
    "weights": {
      "strongest_alert": 35,
      "stage_diversity": 30,
      "stage_order": 15,
      "corroboration": 20
    },
    "severity_bands": {
      "critical": 75,
      "high": 50,
      "medium": 25,
      "low": 0
    }
  },
  "report": {
    "title": "NetGuard Incident & Forensic Analysis Report"
  }
